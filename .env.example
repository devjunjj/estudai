# Copie este arquivo para ".env" e preencha com seus valores.
# O .env está no .gitignore e nunca deve ir para o GitHub.

# Supabase (Project Settings > API Keys) — usado para login
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_publishable_ou_anon_key

# Google AI Studio (https://aistudio.google.com/apikey)
# Usada só em desenvolvimento (npm run dev). Em produção a chave fica no
# servidor, na variável GEMINI_API_KEY (sem o prefixo VITE_).
VITE_GEMINI_API_KEY=sua_chave_gemini
