# Copie este arquivo para ".env" e preencha com seus valores.
# O .env está no .gitignore e nunca deve ir para o GitHub.

# Supabase (Project Settings > API Keys) — usado para login
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_publishable_ou_anon_key

# Endereço da API em C# (pasta backend/). Em desenvolvimento: http://localhost:5018
# A chave do Gemini NÃO fica aqui: ela fica só na API (Gemini:ApiKey).
VITE_API_URL=http://localhost:5018
